# Primary key. After 3.5 Flash-Lite hits 500 RPD, the code switches to 3.1 Flash-Lite.
# Replace this key when 3.1 Flash-Lite also hits 500 RPD.
GEMINI_API_KEY=

# Optional extras
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Must stay a flash-lite model
GEMINI_MODEL=gemini-3.5-flash-lite
